  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#91A2A8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#6E9E8B"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#8BBE95"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#4196C7"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#6997A7"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#6997A7"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#6997A7"
      }
    },
    {
      "scope": [
        "storage.type",
        "entity.name.tag",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#B7875A"
      }
    },
    {
      "scope": "punctuation.definition.tag",
      "settings": {
        "foreground": "#9CB1B8"
      }
    },
    {
      "scope": [
        "variable",
        "meta.variable"
      ],
      "settings": {
        "foreground": "#EDE6D5"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#EDE6D5"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#EDE6D5"
      }
    },
    {
      "scope": [
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#DBBC7F"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.name.decorator"
      ],
      "settings": {
        "foreground": "#B7875A"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#CF7677"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#6997A7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#6997A7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#9583B8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold.markdown markup.italic.markdown",
        "markup.italic.markdown markup.bold.markdown",
        "markup.bold.italic"
      ],
      "settings": {
        "foreground": "#DBBC7F",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#91A2A8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw.inline.markdown"
      ],
      "settings": {
        "foreground": "#4196C7"
      }
    },
    {
      "scope": [
        "string.unquoted.argument"
      ],
      "settings": {
        "foreground": "#4196C7"
      }
    },
    {
      "scope": [
        "meta.embedded.block.shellscript string.quoted",
        "meta.embedded.block.shellscript string.interpolated"
      ],
      "settings": {
        "foreground": "#4196C7"
      }
    },
    {
      "scope": [
        "constant.other.option"
      ],
      "settings": {
        "foreground": "#B7875A"
      }
    },
    {
      "scope": [
        "punctuation.definition.markdown",
        "punctuation.definition.list.markdown",
        "punctuation.definition.string.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#9CB1B8"
      }
    },
    {
      "scope": [
        "string.other.link.description.title.markdown",
        "markup.underline.link.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#6997A7",
        "fontStyle": "underline"
      }
    }
  ]
}
