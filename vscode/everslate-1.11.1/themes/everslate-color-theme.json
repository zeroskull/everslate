{
  "name": "everslate",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#6997A7",
    "interface": "#6997A7",
    "type": "#6997A7",
    "enum": "#6997A7",
    "namespace": "#6997A7",
    "enumMember": "#DBBC7F",
    "boolean": "#4196C7",
    "number": "#4196C7",
    "string": "#8BBE95",
    "keyword": "#6E9E8B",
    "function": "#6997A7",
    "method": "#6997A7",
    "variable": "#EDE6D5",
    "parameter": "#EDE6D5",
    "property": "#EDE6D5",
    "variable.readonly": "#EDE6D5",
    "property.readonly": "#EDE6D5",
    "decorator": "#B7875A",
    "macro": "#B7875A",
    "operator": "#B7875A"
  },
  "colors": {
