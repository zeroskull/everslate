    "terminal.ansiBrightYellow": "#DBBC7F",
    "terminal.ansiBlue": "#4196C7",
    "terminal.ansiBrightBlue": "#7FBBB3",
    "terminal.ansiMagenta": "#9583B8",
    "terminal.ansiBrightMagenta": "#EAACC9",
