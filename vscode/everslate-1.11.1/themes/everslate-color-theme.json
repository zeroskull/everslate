    "gitDecoration.stageModifiedResourceForeground": "#DBBC7F",
    "gitDecoration.stageDeletedResourceForeground": "#CF7677",
    "gitDecoration.renamedResourceForeground": "#9583B8",
    "gitDecoration.submoduleResourceForeground": "#8BBACA",
